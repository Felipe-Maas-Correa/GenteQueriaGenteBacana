rules_version = '2';

// Regras de segurança do Firestore — Gente Querida, Gente Bacana.
//
// Esta é a proteção real dos dados (equivalente ao RLS). A interface apenas
// esconde botões; estas regras impedem o acesso de fato. Publique-as no
// Console do Firebase (Firestore Database > Regras) ou com a CLI.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        ? get(/databases/$(database)/documents/profiles/$(uid)).data.role
        : 'reader';
    }

    function myRole() {
      return signedIn() ? roleOf(request.auth.uid) : 'reader';
    }

    function isStaff() {
      return myRole() in ['admin', 'editor'];
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    // Perfis: cada um lê o seu; admin lê todos. Ninguém promove a si mesmo.
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Primeiro acesso: o usuário cria o próprio perfil sempre como 'reader' (leitor).
      // Para promover alguém a admin/editor, altere o campo role direto no banco
      // ou use Sistema › Equipe (somente administradores).
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'reader';

      // Admin altera qualquer perfil; o próprio usuário pode alterar o seu
      // desde que NÃO mude o papel.
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role)
      );

      allow delete: if isAdmin();
    }

    // Áreas e assinantes: somente a equipe (admin/editor).
    match /areas/{id} {
      allow read, create, update, delete: if isStaff();
    }

    match /subscribers/{id} {
      allow read, create, update, delete: if isStaff();
    }

    // Editorias (menu do site): qualquer visitante lê; só administradores editam.
    match /editorias/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Fotos das notícias em base64: qualquer visitante lê (as fotos aparecem
    // no site, que é estático); só a equipe envia ou apaga.
    // Leitores também enviam a própria foto de perfil (kind "avatar", pequena).
    match /imagens/{id} {
      allow read: if true;
      allow delete: if isStaff();
      allow create: if request.resource.data.data is string && (
        (isStaff() && request.resource.data.data.size() < 900000) ||
        (signedIn()
          && request.resource.data.kind == 'avatar'
          && request.resource.data.created_by == request.auth.uid
          && request.resource.data.data.size() < 120000)
      );
      allow update: if false;
    }

    // ── Assinatura digital e faturas ───────────────────────────
    // Mensalidade padrão: quem está logado lê; só administradores alteram.
    match /config/assinatura {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Uma assinatura por leitor (id = uid). O leitor assina sozinho: já nasce
    // ativa, sem preço especial, com o dia de vencimento escolhido e a
    // cobrança a partir do mês seguinte. Status e preço especial são da equipe.
    function validSelfSubscription() {
      let d = request.resource.data;
      return d.status == 'ativa'
        && d.custom_price_cents == null
        && d.due_day is int && d.due_day >= 1 && d.due_day <= 28
        && d.first_due_month is string;
    }

    match /assinaturas/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && validSelfSubscription();
      allow update: if isStaff() || (
        signedIn() && request.auth.uid == uid && (
          // Reassinar depois de cancelada.
          (resource.data.status == 'cancelada' && validSelfSubscription()) ||
          // Ajustar os próprios dados sem mexer em status nem preço.
          (request.resource.data.status == resource.data.status
            && request.resource.data.custom_price_cents == resource.data.custom_price_cents)
        )
      );
      allow delete: if isAdmin();
    }

    // Faturas: cada um lê as suas (consulta filtrada por uid); a equipe
    // gera e dá baixa. A futura integração de pagamento grava pelo servidor.
    match /faturas/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create, update, delete: if isStaff();
    }

    // Notícias: qualquer visitante lê as publicadas; a equipe lê e edita tudo.
    // Consultas públicas precisam filtrar por status == "published".
    match /articles/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create, update, delete: if isStaff();
    }
  }
}
