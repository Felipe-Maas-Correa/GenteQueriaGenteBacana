# Supabase — Project Settings > API Keys / Data API
# URL do projeto, ex.: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública ("publishable key", sb_publishable_...). Projetos antigos podem
# usar a chave "anon" em NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site (usada em metadados/SEO). Em produção, o domínio final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IMPORTANTE: a chave service_role NÃO é utilizada pela aplicação e nunca deve
# ser colocada em variáveis NEXT_PUBLIC_ nem enviada ao repositório.
